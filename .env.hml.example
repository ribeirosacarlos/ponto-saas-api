# APP
APP_NAME=Jornafy
APP_ENV=staging
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://hml-api.jornafy.com
APP_TIMEZONE=America/Sao_Paulo
APP_INVITE_URL=https://hml.jornafy.com/invite
FRONTEND_URL=https://hml.jornafy.com
CORS_ALLOWED_ORIGINS=https://hml.jornafy.com
SANCTUM_STATEFUL_DOMAINS=hml.jornafy.com,hml-api.jornafy.com
SANCTUM_EXPIRATION_MINUTES=43200
SESSION_COOKIE=jornafy_hml_session
SESSION_DOMAIN=.jornafy.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=*
L5_SWAGGER_BASE_PATH=/api
L5_SWAGGER_USERNAME=change-me
L5_SWAGGER_PASSWORD=change-me

# DATABASE
DB_CONNECTION=pgsql
DB_HOST=hml-db
DB_PORT=5432
DB_DATABASE=jornafy_hml
DB_USERNAME=jornafy_hml
DB_PASSWORD=change-me
DB_CHARSET=utf8

# REDIS
# Redis is not started by docker-compose.hml.yml because production currently uses database-backed cache/session/queue.
# If you add a Redis service later, keep this prefix isolated from production.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=jornafy_hml_

# CACHE
CACHE_STORE=database
CACHE_PREFIX=jornafy_hml_cache_

# SESSION
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# QUEUE
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids

# MAIL
# Keep HML isolated. Use "log" unless a dedicated Mailtrap/Mailpit SMTP is configured.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=stderr
MAIL_FROM_ADDRESS=no-reply@hml.jornafy.com
MAIL_FROM_NAME="Jornafy HML"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_TOLERANCE=300
RESEND_OUTREACH_FROM_ADDRESS=outreach@outreach.hml.jornafy.com
RESEND_OUTREACH_FROM_NAME="Jornafy HML"

# STRIPE
# Use Stripe test mode keys only. Never use sk_live/whsec_live in HML.
STRIPE_SECRET=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_FROM_HML_ENDPOINT
STRIPE_WEBHOOK_LOG_LEVEL=debug

# STORAGE
# Prefer a dedicated HML bucket/prefix if S3 is required.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
BLOG_DEFAULT_IMAGE_URL=

# CLOUDFLARE / PROXY
CLOUDFLARE_SSL_MODE=full_strict
HML_API_DOMAIN=hml-api.jornafy.com

# N8N
# Optional: only used when the n8n compose profile is enabled.
N8N_HML_HOST=hml-n8n.jornafy.com
N8N_HML_WEBHOOK_URL=https://hml-n8n.jornafy.com/
N8N_ENCRYPTION_KEY=change-me-use-a-long-random-key
